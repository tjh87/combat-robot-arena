{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tests/gameplay-pacing.mjs && node --import tsx tests/performance.ts && node scripts/build.mjs && node scripts/verify.mjs",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/online.ts": {
      "maxDuration": 300,
      "includeFiles": ".online/**"
    }
  },
  "headers": [
    {
      "source": "/api/online",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
