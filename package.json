{
  "name": "combat-robot-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx tests/run.ts",
    "test:systems": "node --import tsx tests/systems.ts",
    "test:extended": "node --import tsx tests/extended.ts",
    "test:review": "node --import tsx tests/review-core.ts && node --import tsx tests/review-ui.ts",
    "test:visuals": "node --import tsx tests/visuals.ts",
    "test:roster": "node --import tsx tests/roster.ts",
    "start": "node scripts/serve.mjs --open",
    "verify": "node scripts/verify.mjs",
    "verify:physics": "node scripts/verify.mjs --physics",
    "test:performance": "node --import tsx tests/performance.ts",
    "online:build": "node scripts/online-build.mjs",
    "online:test": "node --import tsx tests/online-core.ts",
    "online:serve": "node --import tsx server/local.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.0",
    "@vercel/analytics": "^2.0.1",
    "ioredis": "5.8.2",
    "three": "0.180.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
